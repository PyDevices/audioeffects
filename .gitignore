.venv/
# A worktree gets its own venv so it cannot install over another checkout's.
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
*.pyd

# Testing & lint caches
.pytest_cache/
.ruff_cache/

# Audio is generated, never committed. The measurement kit's probes are
# written on demand by tools/effect_probes/make_probes.py, and lint fails
# if a WAV is tracked anywhere.
*.wav
*.WAV
tools/effect_probes/*/

# Generated on every docs build
docs/reference/index.rst
docs/reference/audio*.rst
